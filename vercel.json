{
  "cleanUrls": true,
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "Permissions-Policy", "value": "camera=(self)" },
      { "key": "X-Content-Type-Options", "value": "nosniff" }
    ]},
    { "source": "/(.*)\\.wasm", "headers": [ { "key": "Content-Type", "value": "application/wasm" } ] },
    { "source": "/(.*)\\.glb", "headers": [ { "key": "Content-Type", "value": "model/gltf-binary" } ] },
    { "source": "/(vendor|models)/(.*)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" } ] }
  ]
}
